{
  "name": "settlr",
  "private": true,
  "version": "1.0.0",
  "description": "Settlr — split bills with friends: groups, itemized receipts, bill scanning (Node + React + SQLite/Turso).",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev -w server\" \"npm:dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "node --test shared/*.test.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": "22.x"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
