# Copy to .env (repo root) for local development. Never commit .env.
# In production, set these in Vercel → Settings → Environment Variables instead.
# Full guide: docs/DEPLOYMENT.md

# --- Bill scanning (https://openrouter.ai/keys — free models cost nothing) ---
OPENROUTER_API_KEY=
# Optional: one model id, or a comma-separated fallback list (max 3). Must accept images.
# Default: nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free
# OPENROUTER_MODEL=

# --- Sign-up ---
# Optional locally, recommended in production: sign-up requires this code.
# SETTLR_INVITE_CODE=

# --- Production only (leave unset locally: a SQLite file in server/data is used) ---
# DATABASE_URL=libsql://settlr-<your-org>.turso.io
# DATABASE_AUTH_TOKEN=
# SETTLR_SECRET=            # openssl rand -hex 48
